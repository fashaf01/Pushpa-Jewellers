{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/main?__path=:path*" }
  ],
  "functions": {
    "api/main.js": { "maxDuration": 20 }
  },
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
