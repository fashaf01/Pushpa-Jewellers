# Pushpa Jewellers — Apache / LiteSpeed config for Hostinger.
# Lives in public_html/ next to index.html.

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Always use HTTPS (turn on the free SSL in hPanel first).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The address is https://pushpa-jewellers.com/ (no www). Send www there, and the misspelled
# pushpajewelers.com (bought first by mistake) too, so old links still arrive.
# Other hosts (Hostinger's temporary preview domain) are left alone.
RewriteCond %{HTTP_HOST} ^(www\.)?pushpajewelers\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.pushpa-jewellers\.com$ [NC]
RewriteRule ^ https://pushpa-jewellers.com%{REQUEST_URI} [L,R=301]

# ---------- Coming soon ----------
# While the file coming-soon.on is in the site folder, visitors see /coming-soon/ instead of the site.
# The owner sees the real site after opening https://pushpa-jewellers.com/?preview=pushpa1967 once in that
# browser (it leaves a cookie for 30 days). The admin, the API and the files pages load keep working, so staff
# can keep adding pieces. To launch the site, delete coming-soon.on (in the repository: Hostinger deploys it).
RewriteCond %{DOCUMENT_ROOT}/coming-soon.on -f
RewriteCond %{QUERY_STRING} (^|&)preview=pushpa1967(&|$)
RewriteRule ^ %{REQUEST_URI}? [CO=pj_preview:pushpa1967:pushpa-jewellers.com:43200:/:1:1,R=302,L]
RewriteCond %{DOCUMENT_ROOT}/coming-soon.on -f
RewriteCond %{HTTP_COOKIE} !(^|;\s*)pj_preview=pushpa1967(;|$)
RewriteCond %{REQUEST_URI} !^/(admin|api|assets|coming-soon)(/|$)
RewriteCond %{REQUEST_URI} !\.(webp|png|jpe?g|gif|svg|ico|css|js|woff2?|txt|xml)$ [NC]
RewriteRule ^ /coming-soon/index.html [L]

# /api/*(the shop backend, including the website's /api/gold bar) is handled by api/.htaccess.
# The admin panel is at /admin/.

# Short links: /shop -> /shop/ and so on.
RewriteRule ^(shop|about|services/pawning|services/money-exchange|services/airline-ticketing)$ /$1/ [R=301,L]
RewriteRule ^services/?$ /#services [NE,R=302,L]

# Keep repository-only files private.
RewriteRule ^(\.git|\.github|tools|docs|design|dist|node_modules)(/|$) - [F,L]
<FilesMatch "^(README\.md|.*\.zip|.*\.sh|.*\.py|\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Pages revalidate every visit so edits show at once; images, fonts, CSS and JS stay a week.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # pages differ by the preview cookie while the site is "coming soon", so no shared cache may keep them
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, private"
    Header append Vary "Cookie"
  </FilesMatch>
</IfModule>
